      ],
      "source": [
        "n = int(input(\"Nhập số nguyên dương n: \"))\n",
        "print(n)\n",
        "\n",
        "tong = 0\n",
        "for i in range(2, n, 2):\n",
        "    tong += i\n",
        "\n",
        "print(\"Tổng các số chẵn nhỏ hơn\", n, tong)"
